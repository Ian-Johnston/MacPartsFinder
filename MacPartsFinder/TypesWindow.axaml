<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MacPartsFinder"
        x:Class="MacPartsFinder.TypesWindow"
        Title="Part types"
        Width="620" Height="480" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="85" />
        </Style>
        <Style Selector="DataGrid CheckBox">
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12,10,12,10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Untick the types you don't want - their parts are hidden from the results (not deleted). Each supplier words its types its own way, so similar ones may appear more than once. A new search shows every type again." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <Button Content="Tick all" Click="BtnAll_Click" ToolTip.Tip="Show every type." />
                <Button Content="Untick all" Click="BtnNone_Click" ToolTip.Tip="Hide every type - then tick just the ones you want." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Click="BtnOK_Click" ToolTip.Tip="Show the ticked types and hide the rest." />
                <Button Content="Cancel" IsCancel="True" Click="BtnCancel_Click" ToolTip.Tip="Close without changing anything." />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="gridTypes" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True" SelectionMode="Single" RowHeight="24">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Type" Width="260" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TypeEntry">
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Parts" Binding="{Binding Count, StringFormat='{}{0:#,##0}'}" x:DataType="local:TypeEntry"
                                    Width="60" SortMemberPath="Count" CellStyleClasses="right" />
                <DataGridTextColumn Header="Suppliers" Binding="{Binding SuppliersText}" x:DataType="local:TypeEntry" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
