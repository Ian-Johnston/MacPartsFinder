<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MacPartsFinder.HelpWindow"
        Title="MacPartsFinder    Help"
        Width="820" Height="650" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="10,8">
            <Button x:Name="btnOK" Content="OK" IsDefault="True" IsCancel="True" MinWidth="85" HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center" Click="BtnOK_Click" ToolTip.Tip="Close Help (Esc)." />
        </Border>
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="content" Margin="18,10,18,14" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
