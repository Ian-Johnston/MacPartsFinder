<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MacPartsFinder.KeysWindow"
        Title="API keys (temporary, for testing)"
        SizeToContent="Height" Width="520" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- Temporary: the full Settings window (as in WinPartsFinder) replaces this. -->
    <StackPanel Margin="16" Spacing="12">
        <TextBlock TextWrapping="Wrap"
                   Text="Enter your own API keys. They're saved on this computer only - in the macOS Keychain on a Mac, encrypted for your user on Windows - never in the settings file or the app. Leave a box empty for no key." />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Text="Mouser API key:" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMouser" PasswordChar="•" />
            <TextBlock Grid.Row="1" Text="DigiKey Client ID:" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDigiKeyId" PasswordChar="•" />
            <TextBlock Grid.Row="2" Text="DigiKey Client Secret:" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDigiKeySecret" PasswordChar="•" />
            <TextBlock Grid.Row="3" Text="element14 API key:" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtElement14" PasswordChar="•" />
            <TextBlock Grid.Row="4" Text="TME Token:" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtTmeToken" PasswordChar="•" />
            <TextBlock Grid.Row="5" Text="TME Application secret:" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtTmeSecret" PasswordChar="•" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Click="BtnOk_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" Click="BtnCancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
