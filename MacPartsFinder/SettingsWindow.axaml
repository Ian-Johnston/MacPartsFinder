<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MacPartsFinder"
        x:Class="MacPartsFinder.SettingsWindow"
        Title="Settings"
        Width="900" Height="850" MinWidth="760" MinHeight="790"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Grid#keys > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid#keys > HyperlinkButton">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <!-- Supplier headings (with Get a key beside them), a gap above all but the first; their boxes' labels indented below -->
        <Style Selector="Grid#keys > StackPanel.head">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style Selector="Grid#keys > StackPanel.head > TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid#keys > StackPanel.head > HyperlinkButton">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Grid#keys > StackPanel.head.next">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <!-- The lines above and below the Prices section -->
        <Style Selector="Grid#keys > Rectangle.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Grid#keys > TextBlock.sub">
            <Setter Property="Margin" Value="18,0,0,0" />
        </Style>
        <Style Selector="StackPanel#buttons > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12,10,12,10">
        <!-- Bottom buttons, as in WinPartsFinder -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel x:Name="buttons" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="btnResetUrls" Content="Reset URLs" MinWidth="110" Click="BtnResetUrls_Click"
                        ToolTip.Tip="Put the built-in suppliers' search URLs back to the defaults. Your own suppliers are kept." />
                <Button x:Name="btnResetWindow" Content="Reset main window layout" MinWidth="170" Click="BtnResetWindow_Click"
                        ToolTip.Tip="Put the main window back to its original size and position, with the default column widths and order.&#10;Happens when you click OK." />
                <Button x:Name="btnOK" Content="OK" IsDefault="True" MinWidth="85" Click="BtnOK_Click"
                        ToolTip.Tip="Save these settings. Keys are stored in your macOS Keychain (encrypted for your user on Windows)." />
                <Button Content="Cancel" IsCancel="True" MinWidth="85" Click="BtnCancel_Click"
                        ToolTip.Tip="Close without saving any changes." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <CheckBox x:Name="chkDarkMode" Content="Dark mode" IsCheckedChanged="ChkDarkMode_Changed"
                          ToolTip.Tip="Switch the whole app to a dark theme. Previews here straight away." />
                <CheckBox x:Name="chkShowThumbnails" Content="Show part photos"
                          ToolTip.Tip="Show a small part photo at the start of each result row. Untick for a compact grid." />
                <CheckBox x:Name="chkShowKeys" Content="Show keys" IsCheckedChanged="ChkShowKeys_Changed"
                          ToolTip.Tip="Show the API keys as plain text instead of dots." />
            </StackPanel>
        </DockPanel>

        <!-- One heading per supplier with its Get a key link beside it, its boxes indented below (as in WinPartsFinder) -->
        <Grid x:Name="keys" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="6" ColumnSpacing="10">
            <!-- Mouser -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Classes="head">
                <TextBlock Text="Mouser" />
                <HyperlinkButton Content="Get a key" Tag="https://www.mouser.co.uk/api-hub/" Click="KeyLink_Click"
                                 ToolTip.Tip="Opens Mouser's API Hub - sign up there for a free Search API key." />
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="sub" Text="Search API key:" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMouserKey" PasswordChar="•"
                     ToolTip.Tip="Your Mouser Search API key (a long code with dashes).&#10;Leave blank to use Mouser as a website link only." />

            <!-- DigiKey -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Classes="head next">
                <TextBlock Text="DigiKey" />
                <HyperlinkButton Content="Get a key" Tag="https://developer.digikey.com/" Click="KeyLink_Click"
                                 ToolTip.Tip="Opens the DigiKey developer portal - create an Organization, then a Production App." />
            </StackPanel>
            <TextBlock Grid.Row="3" Classes="sub" Text="Client ID:" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDkClientId" PasswordChar="•"
                     ToolTip.Tip="Client ID of your DigiKey Production App (with ProductInformation V4 ticked)." />
            <TextBlock Grid.Row="4" Classes="sub" Text="Client Secret:" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtDkSecret" PasswordChar="•"
                     ToolTip.Tip="Client Secret of the same DigiKey app. Keep it private, like a password." />
            <TextBlock Grid.Row="5" Classes="sub" Text="Site:" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="cboDkSite" Width="80" IsEditable="True" MaxDropDownHeight="400"
                          ToolTip.Tip="Which DigiKey country site to price and stock from (UK = digikey.co.uk, NZ = digikey.co.nz ...).&#10;Pick one, or type any other DigiKey country code." />
                <TextBlock Text="Currency:" VerticalAlignment="Center" />
                <ComboBox x:Name="cboDkCurrency" Width="80" IsEditable="True" MaxDropDownHeight="400"
                          ToolTip.Tip="Currency DigiKey prices are shown in. Pick one, or type another currency code." />
            </StackPanel>

            <!-- element14 -->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Classes="head next">
                <TextBlock Text="element14 - Farnell, CPC and Newark (one key for all three)" />
                <HyperlinkButton Content="Get a key" Tag="https://partner.element14.com/" Click="KeyLink_Click"
                                 ToolTip.Tip="Opens the element14 partner portal - register an application for a free key." />
            </StackPanel>
            <TextBlock Grid.Row="7" Classes="sub" Text="API key:" />
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtE14Key" PasswordChar="•"
                     ToolTip.Tip="Your element14 Product Search API key. One key covers Farnell, CPC and Newark." />
            <TextBlock Grid.Row="8" Classes="sub" Text="Farnell store (country):" />
            <ComboBox Grid.Row="8" Grid.Column="1" x:Name="cboFarnellStore" Width="320" HorizontalAlignment="Left"
                      MaxDropDownHeight="420" SelectionChanged="CboFarnellStore_SelectionChanged"
                      ToolTip.Tip="Which Farnell / element14 country store to use for the Farnell supplier: its stock, prices and currency.&#10;The same element14 key works for every store. CPC (UK) and Newark (USA) aren't affected." />

            <!-- TME -->
            <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Classes="head next">
                <TextBlock Text="TME" />
                <HyperlinkButton Content="Get a key" Tag="https://developers.tme.eu/en" Click="KeyLink_Click"
                                 ToolTip.Tip="Opens the TME developer site - create an application there, then generate a private key (see API Help)." />
            </StackPanel>
            <TextBlock Grid.Row="10" Classes="sub" Text="Token:" />
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtTmeToken" PasswordChar="•"
                     ToolTip.Tip="Your TME private key Token (50 characters), from developers.tme.eu > API Token keys > Show private keys.&#10;Leave blank to use TME as a website link only." />
            <TextBlock Grid.Row="11" Classes="sub" Text="Application secret:" />
            <TextBox Grid.Row="11" Grid.Column="1" x:Name="txtTmeSecret" PasswordChar="•"
                     ToolTip.Tip="The Application secret (20 characters) of your app at developers.tme.eu. Keep it private, like a password." />
            <TextBlock Grid.Row="12" Classes="sub" Text="Country:" />
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="cboTmeCountry" Width="80" IsEditable="True" MaxDropDownHeight="400"
                          ToolTip.Tip="Country TME prices and stock are for (two-letter code, e.g. GB, IE, NZ). Pick one or type another." />
                <TextBlock Text="Currency:" VerticalAlignment="Center" />
                <ComboBox x:Name="cboTmeCurrency" Width="80" IsEditable="True"
                          ToolTip.Tip="Currency TME prices are shown in. TME's own currencies are EUR, USD and PLN; GBP also works." />
            </StackPanel>
            <Button Grid.Row="12" Grid.Column="2" Content="API Help" MinWidth="85" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Click="BtnApiHelp_Click"
                    ToolTip.Tip="Step-by-step instructions for getting each supplier's free API keys.&#10;Stays open beside Settings while you paste the keys in." />

            <!-- Prices in one currency, between two rule lines -->
            <Rectangle Grid.Row="13" Grid.ColumnSpan="3" Classes="rule" Margin="0,8,0,0" />
            <TextBlock Grid.Row="14" Grid.ColumnSpan="2" FontWeight="Bold" Text="Prices - Single currency (if enabled)" />
            <TextBlock Grid.Row="15" Classes="sub" Text="Show prices in:" />
            <StackPanel Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="cboConvertCurrency" Width="80" MaxDropDownHeight="400"
                          ToolTip.Tip="The currency for the main window's &quot;Prices in&quot; tick box. Every price is converted into it using the&#10;European Central Bank's daily rates. Converted prices are shown in purple and are approximate." />
                <TextBlock x:Name="lblRates" Text="Rates:" VerticalAlignment="Center" />
                <Button x:Name="btnUpdateRates" Content="Update now" MinWidth="95" Click="BtnUpdateRates_Click"
                        ToolTip.Tip="Fetch today's exchange rates now. (They're also fetched automatically when they're 12 hours old.)" />
                <HyperlinkButton Content="ECB rates webpage" VerticalAlignment="Center" Click="KeyLink_Click"
                                 Tag="https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html"
                                 ToolTip.Tip="Opens the European Central Bank's euro exchange reference rates page - where the rates come from." />
            </StackPanel>
            <Rectangle Grid.Row="16" Grid.ColumnSpan="3" Classes="rule" Margin="0,2,0,0" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="0,10,0,6" TextWrapping="Wrap"
                   Text="Suppliers and website search URLs - {0} is replaced by the search text. Add your own suppliers here:" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
            <Button Content="Add supplier" MinWidth="110" Click="BtnAddSupplier_Click"
                    ToolTip.Tip="Add your own supplier: give it a name and a search URL containing {0}.&#10;It shows as a website link in the results." />
            <Button x:Name="btnDeleteSupplier" Content="Delete supplier" MinWidth="110" Click="BtnDeleteSupplier_Click"
                    ToolTip.Tip="Delete the selected supplier you added. Built-in suppliers can't be deleted - untick them on the main window instead." />
        </StackPanel>

        <!-- A border round the list, so it's clearly separate from the buttons below it -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <DataGrid x:Name="gridUrls" HeadersVisibility="Column" GridLinesVisibility="All" CanUserSortColumns="False"
                      CanUserReorderColumns="False" SelectionMode="Single" RowHeight="24"
                      BeginningEdit="GridUrls_BeginningEdit" SelectionChanged="GridUrls_SelectionChanged"
                      ToolTip.Tip="Website search URL for each supplier. {0} is replaced by your search text.&#10;Used for website-link rows and for suppliers without an API. Double-click a URL to edit it.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" x:DataType="local:UrlRow" Width="160" />
                    <DataGridTextColumn Header="Search URL" Binding="{Binding Url}" x:DataType="local:UrlRow" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
